function SaveConfig(name)
    if not name or name == "" then return false end
    local cfg = {
        Positions = {},
        Speeds = {},
        Mode = ST.SpdMode,
        LockPower = ST.LockPower,
        Hotkeys = {},
        GUISize = GUIScale,
        LaggerKey = LAG_ST.boundKey and LAG_ST.boundKey.Name or nil,
        AutoLeftRightFull = ST.AutoLeftRightFull,
    }
    for k, elem in pairs(UIElements) do
        if elem and elem.Parent then
            cfg.Positions[k] = {
                X = { Scale = elem.Position.X.Scale, Offset = elem.Position.X.Offset },
                Y = { Scale = elem.Position.Y.Scale, Offset = elem.Position.Y.Offset },
            }
        end
    end
    for k, bx in pairs(BX) do
        if bx and bx.Parent and tonumber(bx.Text) then cfg.Speeds[k] = bx.Text end
    end
    for _, hkc in ipairs(HotkeyConfig) do
        if hkc.saveName and hkc.key then cfg.Hotkeys[hkc.saveName] = hkc.key.Name end
    end
    ST.Configs[name] = cfg
    ST.ActiveConfig = name
    pcall(function()
        if writefile then writefile(CONFIGS_KEY, HttpService:JSONEncode(ST.Configs)) end
    end)
    return true
end

function LoadConfig(name)
    if not name or not ST.Configs[name] then return end
    local cfg = ST.Configs[name]
    if cfg.Positions then
        for k, pos in pairs(cfg.Positions) do
            local elem = UIElements[k]
            if elem and elem.Parent and pos.X and pos.Y then
                pcall(function()
                    TweenService:Create(elem, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                        Position = UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset)
                    }):Play()
                end)
            end
        end
    end
    if cfg.Speeds then
        for k, val in pairs(cfg.Speeds) do
            if BX[k] and BX[k].Parent and tonumber(val) then BX[k].Text = tostring(val) end
        end
    end
    if cfg.Mode then ST.SpdMode = cfg.Mode UpdateMode() end
    if cfg.LockPower then ST.LockPower = cfg.LockPower end
    if cfg.AutoLeftRightFull ~= nil then ST.AutoLeftRightFull = cfg.AutoLeftRightFull end
    if cfg.GUISize then
        GUIScale = math.floor(tonumber(cfg.GUISize) * 100 + 0.5) / 100
        if UpdateGUISizeDisplay then UpdateGUISizeDisplay() end
        ApplyGUIScaleNow()
    end
    if cfg.Hotkeys then
        for _, hkc in ipairs(HotkeyConfig) do
            if hkc.saveName and cfg.Hotkeys[hkc.saveName] then
                local kCode = Enum.KeyCode[cfg.Hotkeys[hkc.saveName]]
                if kCode then
                    hkc.key = kCode
                    if hkc.keyBtn then hkc.keyBtn.Text = kCode.Name end
                end
            end
        end
    end
    if cfg.LaggerKey then
        local kCode = Enum.KeyCode[cfg.LaggerKey]
        if kCode then
            LAG_ST.boundKey = kCode
            if LG and LG.KeyBtn then LG.KeyBtn.Text = "[ " .. cfg.LaggerKey .. " ]" end
        end
    end
    ST.ActiveConfig = name
    SaveSave()
end

function DeleteConfig(name)
    if not name then return end
    ST.Configs[name] = nil
    if ST.ActiveConfig == name then ST.ActiveConfig = nil end
    pcall(function()
        if writefile then writefile(CONFIGS_KEY, HttpService:JSONEncode(ST.Configs)) end
    end)
end

