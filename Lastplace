local function FindBat()
    local c = LP.Character
    local bp = LP:FindFirstChildOfClass("Backpack")
    if c then
        for _, i in ipairs(c:GetChildren()) do
            if i:IsA("Tool") and (i.Name:lower():find("bat") or i.Name:lower():find("baseball")) then return i end
        end
    end
    if bp then
        for _, i in ipairs(bp:GetChildren()) do
            if i:IsA("Tool") and (i.Name:lower():find("bat") or i.Name:lower():find("baseball")) then
                pcall(function()
                    local ch = LP.Character
                    if ch then
                        local hm = ch:FindFirstChildOfClass("Humanoid")
                        if hm then hm:EquipTool(i) end
                    end
                end)
                task.wait(0.05)
                return i
            end
        end
    end
    return nil
