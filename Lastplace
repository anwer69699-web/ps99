local function MakeMovingGradient(parent, speed)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, C.GRN_DARK),
        ColorSequenceKeypoint.new(0.25, C.GRN),
        ColorSequenceKeypoint.new(0.5, C.GRN_BRIGHT),
        ColorSequenceKeypoint.new(0.75, C.GRN),
        ColorSequenceKeypoint.new(1, C.GRN_DARK),
    })
    g.Rotation = 0
    g.Parent = parent
    task.spawn(function()
        local rot = 0
        while parent and parent.Parent and CoreActive do
            rot = rot + (speed or 12) * task.wait(0.05)
            if rot > 360 then rot = rot - 360 end
            pcall(function() g.Rotation = rot end)
        end
    end)
    return g
end

local function BorderGrad(s)
    if not s or s:FindFirstChild("BorderGradG") then return end
    local g = Instance.new("UIGradient")
    g.Name = "BorderGradG"
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(80, 200, 120)),
        ColorSequenceKeypoint.new(0.3, Color3.fromRGB(120, 255, 160)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(180, 255, 200)),
        ColorSequenceKeypoint.new(0.7, Color3.fromRGB(120, 255, 160)),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(80, 200, 120)),
    })
    g.Rotation = 0
    g.Parent = s
    local baseThickness = s.Thickness
    task.spawn(function()
        local rot = 0
        while s and s.Parent and CoreActive do
            rot = (rot + 1.4) % 360
            pcall(function() g.Rotation = rot end)
            local t = tick()
            pcall(function()
                s.Transparency = 0.15 + ((math.sin(t*1.8)+1)/2)*0.1
                s.Thickness = baseThickness + ((math.sin(t*1.4+1)+1)/2)*0.4
            end)
            task.wait(0.04)
        end
    end)
end

