        pathDir = targetHorVel.Unit
    else
        -- الهدف واقف: نأخذ اتجاه نظره كمسار
        pathDir = Vector3.new(target.CFrame.LookVector.X, 0, target.CFrame.LookVector.Z)
        if pathDir.Magnitude > 0.01 then
            pathDir = pathDir.Unit
        else
            pathDir = Vector3.new(0, 0, -1) -- احتياطي إذا كان الاتجاه صفر
        end
    end
    
    -- نقطة الوقوف: أمام المسار بـ 4 ستودز، وتحته بشوي
    local standPos = aimPos + (pathDir * AIM_CFG.DIST) + Vector3.new(0, AIM_CFG.HEIGHT, 0)
    
    -- الدوران لينظر للهدف
    local look = aimPos - root.Position
    local flatLook = Vector3.new(look.X, 0, look.Z)
    hum.AutoRotate = false
    if look.Magnitude > 0.01 and flatLook.Magnitude > 0.01 then
        local tYaw = math.deg(math.atan2(-flatLook.X, -flatLook.Z))
        local yawD = (tYaw - root.Orientation.Y + 180) % 360 - 180
        local tPit = math.deg(math.atan2(look.Y, flatLook.Magnitude))
        local pitD = (tPit - root.Orientation.X + 180) % 360 - 180
        local yawR = math.clamp(math.rad(yawD) * AIM_CFG.TURN_SPEED, -AIM_CFG.MAX_TURN_RATE, AIM_CFG.MAX_TURN_RATE)
        local pitR = math.clamp(math.rad(pitD) * AIM_CFG.TURN_SPEED, -AIM_CFG.MAX_TURN_RATE, AIM_CFG.MAX_TURN_RATE)
        local yRad = math.rad(root.Orientation.Y)
        local rAxis = Vector3.new(math.cos(yRad), 0, -math.sin(yRad))
        _angVel.AngularVelocity = Vector3.new(0, yawR, 0) + (rAxis * pitR)
    else
        _angVel.AngularVelocity = Vector3.zero
    end
    
    local spd = gNS()
    local moveDir = standPos - root.Position
    local hDir = Vector3.new(moveDir.X, 0, moveDir.Z)
    
    -- الحركة بدون أي تباطؤ
