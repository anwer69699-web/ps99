            local t = tick()
            local oscillation = math.sin(t * 3) * 0.3
            local remain = STEAL_DELAY * (0.05 + oscillation * 0.02)
            remain = math.max(0.02, remain)
            local mins = math.floor(remain / 60)
            local secs = math.floor(remain % 60)
            remainText = string.format("%d:%02d", mins, secs)
