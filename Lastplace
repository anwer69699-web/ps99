            ToggleAim()
            SyncToggles()
        end)
        FB.TPD.MouseButton1Click:Connect(function() DoTPDown() end)
        FB.Drop.MouseButton1Click:Connect(function() DoDrop() end)
        FB.Mode.MouseButton1Click:Connect(function() toggleMode() end)
