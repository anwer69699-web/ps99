--// Steal
local function IsMyPlot(pn)
    local pl = workspace:FindFirstChild("Plots")
    if not pl then return false end
    local p = pl:FindFirstChild(pn)
    if not p then return false end
    local s = p:FindFirstChild("PlotSign")
    if s then
        local y = s:FindFirstChild("YourBase")
        if y and y:IsA("BillboardGui") then return y.Enabled == true end
    end
    return false
end

local function FindNearestPrompt()
    local h = gH()
    if not h then return nil end
    local pl = workspace:FindFirstChild("Plots")
    if not pl then return nil end
    local range = SafeGetNumber(BX.ASR, DEFAULTS.AUTO_STEAL_RANGE, 99999)
    local np, npd = nil, math.huge
    for _, pl2 in ipairs(pl:GetChildren()) do
        if IsMyPlot(pl2.Name) then continue end
        local pod = pl2:FindFirstChild("AnimalPodiums")
        if not pod then continue end
        for _, p in ipairs(pod:GetChildren()) do
            pcall(function()
                local b = p:FindFirstChild("Base")
                local sp = b and b:FindFirstChild("Spawn")
                if not sp then return end
                local a = p:FindFirstChild("Animal") or p:FindFirstChildWhichIsA("Model")
                if not a then return end
                local d = (sp.Position - h.Position).Magnitude
                if d < npd and d <= range then
                    local at = sp:FindFirstChild("PromptAttachment")
                    if at then
                        for _, c in ipairs(at:GetChildren()) do
                            if c:IsA("ProximityPrompt") and c.Enabled then
                                np = c; npd = d; break
                            end
                        end
                    end
                end
            end)
        end
    end
    return np, npd
end

local function ExecSteal(pr)
    if ST.isStealing then return end
    if not ST.StealData[pr] then
        ST.StealData[pr] = { h = {}, t = {}, r = true }
        pcall(function()
            if getconnections then
                for _, c in ipairs(getconnections(pr.PromptButtonHoldBegan)) do
                    if c.Function then table.insert(ST.StealData[pr].h, c.Function) end
                end
                for _, c in ipairs(getconnections(pr.Triggered)) do
                    if c.Function then table.insert(ST.StealData[pr].t, c.Function) end
                end
            end
        end)
    end
    local d = ST.StealData[pr]
    if not d.r then return end
    d.r = false
    ST.isStealing = true
    ST.stealStart = tick()
    ST.StealEndTick = tick() + STEAL_DELAY
    ST.StealOscillating = false
    ST.StealTargetPrompt = pr
    task.spawn(function()
        for _, f in ipairs(d.h) do task.spawn(f) end
        task.wait(STEAL_DELAY)
        for _, f in ipairs(d.t) do task.spawn(f) end
        d.r = true
        ST.isStealing = false
        ST.StealEndTick = 0
        ST.StealOscillating = false
        ST.StealTargetPrompt = nil
        task.delay(1, function()
            if not ST.isStealing then
                ST.stealStart = nil
            end
        end)
    end)
end

task.spawn(function()
    while _G.ExtRunning and CoreActive do
        if ST.AutoStealOn and not ST.isStealing then
            local p = FindNearestPrompt()
            if p then ExecSteal(p) end
        end
        task.wait(0.05)
    end
end)

