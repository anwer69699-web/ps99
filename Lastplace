    -- [الخوارزمية النهائية] نحسب اتجاه الحركة الفعلي للهدف
    local targetHorVel = Vector3.new(target.Velocity.X, 0, target.Velocity.Z)
    local moveSpeed = targetHorVel.Magnitude
    
    local pathDir
    if moveSpeed > 5 then
