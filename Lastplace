        vVel = Vector3.new(0, math.sign(moveDir.Y) * AIM_CFG.VERT_SPEED * 1.3, 0)
    elseif math.abs(moveDir.Y) > 0.1 then
        vVel = Vector3.new(0, math.sign(moveDir.Y) * AIM_CFG.VERT_SPEED, 0)
    else
        vVel = Vector3.new(0, -2, 0)
    end
    _intendedVel = hVel + vVel
