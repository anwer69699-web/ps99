function RearrangeFloatButtons()
    local sc = SC()
    local btnSize = 72 * sc
    local gap = 6 * sc
    local margin = 15 * sc
    local colWidth = btnSize + gap
    local positions = {
        {x = -(margin + btnSize), y = 0},
        {x = -(margin + colWidth + btnSize), y = 0},
        {x = -(margin + btnSize), y = btnSize + gap},
        {x = -(margin + colWidth + btnSize), y = btnSize + gap},
        {x = -(margin + btnSize), y = 2 * (btnSize + gap)},
        {x = -(margin + colWidth + btnSize), y = 2 * (btnSize + gap)},
    }
    local order = {"AR", "AL", "Drop", "TPD", "Mode", "Lock"}
    for i, key in ipairs(order) do
        local btn = FB[key]
        local elem = btn and btn.Parent
        if elem then
            local pos = positions[i]
            if pos then
                elem.Size = UDim2.new(0, btnSize, 0, btnSize)
                elem.Position = UDim2.new(1, pos.x, 0.3, pos.y)
                ClampUIOnScreen(elem)
            end
        end
    end
end

function ApplyGUIScaleNow()
    local savedPositions = {}
    pcall(function()
        for name, elem in pairs(UIElements) do
            if elem and elem.Parent then
                savedPositions[name] = {
                    X = { Scale = elem.Position.X.Scale, Offset = elem.Position.X.Offset },
                    Y = { Scale = elem.Position.Y.Scale, Offset = elem.Position.Y.Offset },
                }
            end
        end
    end)
    local wasConfigVisible = ST.ConfigUIVisible
    local wasUPMin = ST.UPMin or false
    local wasLGMin = ST.LGMin or false
    pcall(function()
        if MainGui then MainGui:Destroy() end
        if LaggerGui then LaggerGui:Destroy() end
        if ConfigGui then ConfigGui:Destroy() end
        ConfigGui = nil
        UIElements = {}
        BX, BXLabels = {}, {}
        HotkeyConfig = {}
        ToggleSwitches = {}
        FloatButtons = {}
        FB, SB, HP, LG = {}, {}, {}, {}
        ModeLabel = nil
    end)
    local _gr = {BuildUI()}
    MainGui = _gr[1]
    LaggerGui = _gr[2]
    FB = _gr[3]
    SB = _gr[4]
    HP = _gr[5]
    _gr = nil
    for k, btn in pairs(FB) do FloatButtons[k] = btn end
    LG = BuildLaggerPanel(LaggerGui)
    if wasUPMin and UIElements["UnifiedPanel"] then
        UIElements["UnifiedPanel"].Size = UDim2.new(0, 340 * SC(), 0, 30 * SC())
    end
    if wasLGMin and UIElements["LaggerPanel"] then
        UIElements["LaggerPanel"].Size = UDim2.new(0, 280 * SC(), 0, 28 * SC())
    end
    pcall(function()
        for name, pos in pairs(savedPositions) do
            local elem = UIElements[name]
            if elem and elem.Parent and pos.X and pos.Y then
                elem.Position = UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset)
            end
        end
    end)
    pcall(function()
        if _LoadedSave.Positions then
            for name, pos in pairs(_LoadedSave.Positions) do
                local elem = UIElements[name]
                if elem and elem.Parent and not savedPositions[name] and pos.X and pos.Y then
                    elem.Position = UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset)
                end
            end
        end
    end)
    RestoreTextBoxValues()
    RestoreKeybinds()
    if _LoadedSave.LaggerKey then
        local kCode = Enum.KeyCode[_LoadedSave.LaggerKey]
        if kCode then
            LAG_ST.boundKey = kCode
            if LG and LG.KeyBtn then LG.KeyBtn.Text = "[ " .. _LoadedSave.LaggerKey .. " ]" end
        end
    end
    if LG and LG.PowerLabel then
        LG.PowerLabel.Text = "LOCK POWER: " .. ST.LockPower .. "%"
    end
    setLagger1Visual(LAG_ST.LaggerOn)
    RebindAllButtons()
    UpdateMode()
    SyncToggles()
    if wasConfigVisible then
        ShowConfigUI()
    end
    for _, elem in pairs(UIElements) do
        if elem and elem.Parent then ClampUIOnScreen(elem) end
    end
end

