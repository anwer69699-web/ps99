function toggleLagger()
    if LAG_ST.LaggerOn then
        stopLagger()
        ST.SpdMode = "NORMAL"
        ST.PrevSpdMode = "NORMAL"
        UpdateMode()
        Notify(SCRIPT_NAME, "Lagger OFF - Normal mode", 2, C.RED)
    else
        if not PayloadReady or not ReusablePayload then
            if not PayloadBuilding then PrebuildPayloads() end
            Notify(SCRIPT_NAME, "Building payload... wait", 3, C.YEL)
            return
        end
        ST.PrevSpdMode = ST.SpdMode
        ST.SpdMode = "LAGGER"
        UpdateMode()
        startLagger()
        Notify(SCRIPT_NAME, "Lagger ON", 2, C.GRN)
    end
    setLagger1Visual(LAG_ST.LaggerOn)
    if SyncToggles then SyncToggles() end
end

function toggleMode()
