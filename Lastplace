local CachedRemote = nil
local function resolveRemote(path)
    if not path or path == "" then return nil end
    local ok, result = pcall(function()
        local obj = game
        local cleaned = path:gsub("^game%.", "")
        for seg in cleaned:gmatch("[^%.]+") do
            if obj then
                if typeof(obj) == "Instance" then obj = obj:FindFirstChild(seg)
                else obj = obj[seg] end
            else return nil end
        end
        return obj
    end)
    if ok and result and typeof(result) == "Instance" then return result end
    return nil
end

local function FindAnyRemote()
    if CachedRemote and CachedRemote.Parent then return CachedRemote end
    CachedRemote = nil
    for _, path in ipairs(REMOTE_PATHS) do
        local r = resolveRemote(path)
        if r then CachedRemote = r return r end
    end
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        for _, child in ipairs(RS:GetDescendants()) do
            if child:IsA("RemoteEvent") or child:IsA("UnreliableRemoteEvent") or child:IsA("RemoteFunction") then
                CachedRemote = child
                return
            end
        end
    end)
    return CachedRemote
end

local ReusablePayload = nil
local PayloadBuildKey = nil
local CachedLagRemote = nil
local PayloadRebuildTimer = nil
local PayloadBuilding = false
local PayloadReady = false

local SubChunks = {}
local NUM_SUBCHUNKS = 50
for i = 1, NUM_SUBCHUNKS do
    SubChunks[i] = {}
end

local function BuildPayloadOnce(tc, bs)
    local key = tostring(tc) .. "_" .. tostring(bs)
    if ReusablePayload and PayloadBuildKey == key then PayloadReady = true return end
    if PayloadBuilding then return end
    PayloadBuilding = true
    PayloadReady = false
    local co = coroutine.create(function()
        ReusablePayload = nil
        PayloadBuildKey = key
        local m = {}
        local n = {}
        local z = n
        for i = 1, tc do
            local ins = {}
            table.insert(z, ins)
            z = ins
        end
        local mi = math.floor(bs / (tc + 2))
        local perFrame = 10000
        local i = 1
        while i <= mi do
            local endI = math.min(i + perFrame - 1, mi)
            for j = i, endI do
                m[j] = n
            end
            i = endI + 1
            coroutine.yield()
        end
        ReusablePayload = m
        PayloadBuilding = false
        PayloadReady = true
        pcall(function() collectgarbage("step", 80) end)
    end)
    task.spawn(function()
        while coroutine.status(co) ~= "dead" do
            local ok = coroutine.resume(co)
            if not ok then break end
            task.wait()
        end
    end)
end

local function RebuildPayload()
    if PayloadRebuildTimer then task.cancel(PayloadRebuildTimer) PayloadRebuildTimer = nil end
    PayloadRebuildTimer = task.delay(0.5, function()
        local oldPayload = ReusablePayload
        ReusablePayload = nil
        PayloadBuildKey = nil
        PayloadReady = false
        if LAG_ST.LaggerOn then
            BuildPayloadOnce(LAG_CONFIG.tables, LAG_CONFIG.batchSize)
        end
        oldPayload = nil
        pcall(function() collectgarbage("step", 50) end)
    end)
end

function PrebuildPayloads()
    BuildPayloadOnce(LAG_CONFIG.tables, LAG_CONFIG.batchSize)
end

local activeInvokeThreads = {}
local invokeCooldown = false

local function startLagger()
    if LAG_ST.LaggerThread then return end
    if not PayloadReady or not ReusablePayload then
        if not PayloadBuilding then
            PrebuildPayloads()
        end
        Notify(SCRIPT_NAME, "Building payload... wait", 3, C.YEL)
        task.spawn(function()
            local t = tick()
            while (not PayloadReady or not ReusablePayload) and PayloadBuilding and tick() - t < 10 do
                task.wait(0.1)
            end
            if PayloadReady and ReusablePayload and _G.ExtRunning then
                startLagger()
            end
        end)
        return
    end
    pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge) end)
    CachedLagRemote = FindAnyRemote()
    activeInvokeThreads = {}
    invokeCooldown = false
    LAG_ST.LaggerOn = true
    local function startLaggerLoop()
        local sendCounter = 0
        while LAG_ST.LaggerOn and _G.ExtRunning and CoreActive do
            if not CachedLagRemote or not CachedLagRemote.Parent then
                CachedLagRemote = FindAnyRemote()
            end
            if CachedLagRemote and ReusablePayload and PayloadReady and not PayloadBuilding then
                if CachedLagRemote:IsA("RemoteEvent") or CachedLagRemote:IsA("UnreliableRemoteEvent") then
                    pcall(function() CachedLagRemote:FireServer(ReusablePayload) end)
                elseif CachedLagRemote:IsA("RemoteFunction") then
                    if not invokeCooldown then
                        invokeCooldown = true
                        local thread = coroutine.create(function()
                            pcall(function() CachedLagRemote:InvokeServer(ReusablePayload) end)
                            invokeCooldown = false
                            for i = #activeInvokeThreads, 1, -1 do
                                if activeInvokeThreads[i] == thread then table.remove(activeInvokeThreads, i) end
                            end
                        end)
                        table.insert(activeInvokeThreads, thread)
                        coroutine.resume(thread)
                    end
                end
            end
            sendCounter = sendCounter + 1
            if sendCounter % 2 == 0 then
                task.wait(math.max(LAG_CONFIG.loopWait, 0.05))
            else
                task.wait(math.max(LAG_CONFIG.loopWait * 0.8, 0.04))
            end
        end
    end
    LAG_ST.LaggerThread = coroutine.create(startLaggerLoop)
    coroutine.resume(LAG_ST.LaggerThread)
    _G.ExtLagThread = LAG_ST.LaggerThread
end

local function stopLagger()
    LAG_ST.LaggerOn = false
    for _, t in ipairs(activeInvokeThreads) do pcall(function() coroutine.close(t) end) end
    activeInvokeThreads = {}
    invokeCooldown = false
    if LAG_ST.LaggerThread then
        pcall(function() coroutine.close(LAG_ST.LaggerThread) end)
        LAG_ST.LaggerThread = nil
        _G.ExtLagThread = nil
    end
    pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(0) end)
    task.wait(0.2)
    pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(10000) end)
end

local function StartAutoLaggerWatcher()
    if ST.AutoLaggerWatchThread then return end
    ST.AutoLaggerWatchThread = task.spawn(function()
        local wasActive = false
