    f.ZIndex = 2
    f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 10)
    local st = Instance.new("UIStroke")
    st.Thickness = 2
    st.Color = C.GRN
    st.Parent = f
    BorderGrad(st)
    if elemKey then UIElements[elemKey] = f end
    local btn = Instance.new("TextButton")
    btn.Name = "Btn"
    btn.Text = text
    btn.TextColor3 = C.WHITE
    btn.Font = Enum.Font.GothamBlack
    btn.TextSize = 11 * sc
    btn.BackgroundTransparency = 1
    btn.Size = UDim2.new(1, 0, 1, -14 * sc)
    btn.Position = UDim2.new(0, 0, 0, 14 * sc)
    btn.ZIndex = 5
    btn.TextWrapped = true
    btn.TextXAlignment = Enum.TextXAlignment.Center
    btn.TextYAlignment = Enum.TextYAlignment.Center
    btn.Parent = f
    ApplyIllusionText(btn)
    local dragHandle = Instance.new("TextButton")
    dragHandle.Name = "DragHandle"
    dragHandle.Text = ""
    dragHandle.BackgroundTransparency = 1
    dragHandle.Size = UDim2.new(1, 0, 0, 12 * sc)
    dragHandle.Position = UDim2.new(0, 0, 0, 0)
    dragHandle.ZIndex = 4
    dragHandle.Parent = f
    dragHandle.Active = true
    for i = 0, 2 do
        local dot = Instance.new("Frame")
        dot.Name = "DragDot" .. i
        dot.BackgroundColor3 = C.GRN
        dot.Size = UDim2.new(0, 2 * sc, 0, 2 * sc)
        dot.Position = UDim2.new(0.5, (i - 1) * 6 * sc, 0.5, 0)
        dot.ZIndex = 6
        dot.Parent = dragHandle
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
    end
    MakeRobloxDrag(f, dragHandle)
    Hover(btn, C.HVR, C.BG)
    ClkFX(btn)
    task.spawn(function()
        while btn and btn.Parent and CoreActive do
            local isOn = btn:GetAttribute("On")
            if isOn then
                TweenService:Create(st, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Thickness = 3.5, Color = C.GRN_BRIGHT }):Play()
                task.wait(0.8)
                TweenService:Create(st, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Thickness = 2, Color = C.GRN }):Play()
                task.wait(0.8)
            else
                TweenService:Create(st, TweenInfo.new(0.4), { Thickness = 1.5, Color = C.RED }):Play()
                task.wait(0.5)
            end
        end
    end)
    return btn, f, st
end

