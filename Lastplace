    pcall(function() if _angVelAtt and _angVelAtt.Parent then _angVelAtt:Destroy() end end)
    _angVel = nil; _angVelAtt = nil
end

local function GetAimTarget()
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local now = tick()
    if now - _aimTargetLastScan <= 0.1 and _aimTarget and _aimTarget.Parent then
        local h = _aimTarget.Parent:FindFirstChildOfClass("Humanoid")
        if h and h.Health > 0 then return _aimTarget end
    end
    _aimTargetLastScan = now
    local closest, minD = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local tr = plr.Character:FindFirstChild("HumanoidRootPart")
            local h = plr.Character:FindFirstChildOfClass("Humanoid")
            if tr and h and h.Health > 0 then
                local d = (tr.Position - root.Position).Magnitude
                if d < minD then minD = d; closest = tr end
            end
        end
    end
    if closest ~= _aimTarget then
        _velSmooth = Vector3.zero
        _jumpHistory = {}
        _infJumpDetected = false
        _tpDownDetected = false
        _jumpCount = 0
        _peakY = 0
    end
    _aimTarget = closest
    return _aimTarget
end

local function recordTargetData(targetHRP)
    if not targetHRP then return end
    table.insert(_jumpHistory, targetHRP.Velocity.Y)
    if #_jumpHistory > AIM_CFG.MAX_JUMP_HISTORY then table.remove(_jumpHistory, 1) end
end

local function detectInfiniteJump(targetHRP)
    if not targetHRP then
        _infJumpDetected = false; _tpDownDetected = false; _jumpCount = 0
        return "normal"
    end
    local velY = targetHRP.Velocity.Y; local posY = targetHRP.Position.Y
    if posY > _peakY then _peakY = posY end
    local upwardSpikes = 0
    for i = 2, #_jumpHistory do
        if _jumpHistory[i] > AIM_CFG.JUMP_DETECT_THRESHOLD
        and _jumpHistory[i-1] < AIM_CFG.JUMP_DETECT_THRESHOLD * 0.3 then
            upwardSpikes = upwardSpikes + 1
        end
    end
    if upwardSpikes >= AIM_CFG.JUMP_COUNT_TRIGGER and not _infJumpDetected then
        _infJumpDetected = true; _jumpCount = upwardSpikes; _peakY = posY; _tpDownDetected = false
    end
    if _infJumpDetected and velY < AIM_CFG.TP_DOWN_VEL_THRESHOLD then
        _tpDownDetected = true; return "tp_down"
    end
    if _infJumpDetected and velY < -20 and (posY < _peakY - 5) then return "falling" end
    if _infJumpDetected and math.abs(velY) < 5 and posY < _lastTargetY + 2 then
        _normalModeTimer = _normalModeTimer + 1
        if _normalModeTimer > 8 then
            _infJumpDetected = false; _tpDownDetected = false; _jumpCount = 0
            _peakY = 0; _normalModeTimer = 0; _jumpHistory = {}
            return "normal"
        end
    else
        _normalModeTimer = 0
    end
    _lastTargetY = posY
    if _infJumpDetected then return _tpDownDetected and "tp_down" or "infinite_jump" end
    return "normal"
end

local TP_RaycastParams = RaycastParams.new()
TP_RaycastParams.FilterType = Enum.RaycastFilterType.Exclude

local function predictTargetPosition(targetHRP, mode)
    if not targetHRP then return nil end
    local pos = targetHRP.Position; local vel = targetHRP.Velocity
    local delta = (vel - _velSmooth).Magnitude
    if delta < 250 then _velSmooth = _velSmooth * 0.78 + vel * 0.22 end
    local smoothVel = _velSmooth; local smoothSpeed = smoothVel.Magnitude
    if smoothSpeed > 75 then smoothVel = smoothVel.Unit * 75; smoothSpeed = 75 end
    local predictTime = 0
    if mode == "infinite_jump" then
        local vm = math.clamp(smoothVel.Y / 100, -0.3, 0.5)
        predictTime = AIM_CFG.JUMP_PREDICT + vm
        pos = pos + Vector3.new(smoothVel.X * predictTime * 0.5, -2, smoothVel.Z * predictTime * 0.5)
    elseif mode == "tp_down" then
        local landX = pos.X + smoothVel.X * AIM_CFG.TP_DOWN_PREDICT
        local landZ = pos.Z + smoothVel.Z * AIM_CFG.TP_DOWN_PREDICT
        TP_RaycastParams.FilterDescendantsInstances = {LP.Character}
        local rr = workspace:Raycast(Vector3.new(landX, pos.Y, landZ), Vector3.new(0, -200, 0), TP_RaycastParams)
        local gy = rr and rr.Position.Y or pos.Y
        pos = Vector3.new(landX, gy + AIM_CFG.HEIGHT, landZ)
        return pos, true
    elseif mode == "falling" then
        predictTime = AIM_CFG.PREDICT * 0.8
        pos = pos + Vector3.new(smoothVel.X * predictTime, smoothVel.Y * 0.15, smoothVel.Z * predictTime)
    else
        predictTime = math.clamp(smoothSpeed / 130, 0.02, 0.12) * AIM_CFG.PREDICT
        pos = pos + (smoothVel * predictTime)
        pos = pos + targetHRP.CFrame.LookVector * 0.3
    end
    pos = pos + Vector3.new(0, AIM_CFG.V_OFF, 0)
    return pos, false
end

