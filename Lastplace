        if _LoadedSave.AutoLeftRightFull ~= nil then ST.AutoLeftRightFull = _LoadedSave.AutoLeftRightFull end
        ST.AutoLaggerOn = false
    end)
end

local function SafeGetNumber(box, fallback, max)
    if not box or not box.Parent then return fallback end
    local txt = box.Text
    if type(txt) ~= "string" or txt == "" then return fallback end
    local num = tonumber(txt)
    if not num then return fallback end
    if num < 0 then num = 0 end
    if max and num > max then num = max end
    return num
end

local function GetCoord(coord)
    if type(coord) == "table" then
        if coord[1] then return coord[1], coord[2] or 0, coord[3] or 0 end
        return coord.x or 0, coord.y or 0, coord.z or 0
    end
    return 0, 0, 0
end

