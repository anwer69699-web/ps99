-- ===== SAVE/LOAD SYSTEM =====
local function LoadSave()
    local s, r = pcall(function()
        if isfile and isfile(SAVE_KEY) then
            local data = readfile(SAVE_KEY)
            if data and data ~= "" then
                return HttpService:JSONDecode(data)
            end
        end
        return {}
    end)
    return s and (type(r) == "table" and r or {}) or {}
end

local _LoadedSave = LoadSave()

local function SaveSave()
    pcall(function()
        if not writefile then return end
        SaveData.Speeds = SaveData.Speeds or {}
        for k, bx in pairs(BX) do
            if bx and bx.Parent then
                local txt = bx.Text
                if txt and txt ~= "" and tonumber(txt) then
                    SaveData.Speeds[k] = txt
                end
            end
        end

        SaveData.Positions = SaveData.Positions or {}
        for name, elem in pairs(UIElements) do
            if elem and elem.Parent then
                SaveData.Positions[name] = {
                    X = { Scale = elem.Position.X.Scale, Offset = elem.Position.X.Offset },
                    Y = { Scale = elem.Position.Y.Scale, Offset = elem.Position.Y.Offset },
                }
            end
        end

        SaveData.Hotkeys = SaveData.Hotkeys or {}
        for _, cfg in ipairs(HotkeyConfig) do
            if cfg.key and cfg.saveName then
                SaveData.Hotkeys[cfg.saveName] = cfg.key.Name
            end
        end

        if LAG_ST.boundKey then
            SaveData.LaggerKey = LAG_ST.boundKey.Name
        else
            SaveData.LaggerKey = nil
        end

        SaveData.Mode = ST.SpdMode
        SaveData.LockPower = ST.LockPower
        SaveData.Configs = ST.Configs
        SaveData.ActiveConfig = ST.ActiveConfig

        writefile(SAVE_KEY, HttpService:JSONEncode(SaveData))
    end)
end

local function CorrectTextBoxes()
    pcall(function()
        for k, bx in pairs(BX) do
            if bx and bx.Parent then
                local txt = bx.Text
                if txt and txt ~= "" then
                    local num = tonumber(txt)
                    if num then
                        local clamped = math.clamp(num, 0, 999)
                        local rounded = math.floor(clamped * 100 + 0.5) / 100
                        if rounded ~= num then
                            bx.Text = tostring(rounded)
                        end
                    end
                end
            end
        end
    end)
end

