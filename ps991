    TweenService:Create(LG.SwBg, TweenInfo.new(0.15), { BackgroundColor3 = st and Color3.fromRGB(20, 50, 30) or Color3.fromRGB(40, 15, 15) }):Play()
    LG.StatusLbl.Text = st and L("lagger_on") or L("lagger_off")
    LG.StatusLbl.TextColor3 = st and col or C.RED
end

function UpdateMode()
    if ModeLabel then
        ModeLabel.Text = L("mode") .. ": " .. L(ST.SpdMode:lower())
    end
    if FB.Mode then
        FB.Mode.Text = L("mode_toggle") .. "\n" .. L(ST.SpdMode:lower())
    end
end

ST.PrevSpdMode = "NORMAL"

local function toggleLagger()
    if LAG_ST.LaggerOn then
        stopLagger()
        if ST.SpdMode == "LAGGER" then
            ST.SpdMode = ST.PrevSpdMode
            BX.J.Text = tostring(ST.PrevSpdMode == "LAGGER" and LIMITS.LAGGER_JUMP or LIMITS.NORMAL_JUMP)
            UpdateMode()
        end
        Notify("EXTERNAL HUB", L("lagger_off"), 2, C.RED)
    else
        ST.PrevSpdMode = ST.SpdMode
        ST.SpdMode = "LAGGER"
        BX.J.Text = tostring(LIMITS.LAGGER_JUMP)
        UpdateMode()
        startLagger()
        Notify("EXTERNAL HUB", L("lagger_on"), 2, C.GRN)
    end
    setToggleVisual(LAG_ST.LaggerOn)
end

