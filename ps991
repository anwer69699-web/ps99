local OriginalIndex = nil
local OriginalNewIndex = nil

local function InstallHooks()
    local mt = getrawmetatable(game)
    setreadonly(mt, false)

    OriginalIndex = hookfunction(mt.__index, function(self, key)
        if ST.SpoofActive and typeof(self) == "Instance" and self:IsA("Humanoid") and key == "WalkSpeed" then
            local char = self.Parent
            if char and Players:GetPlayerFromCharacter(char) == LP then
                return ST.SpeedPool[ST.CurrentIndex] or 16
            end
        end
        return OriginalIndex(self, key)
    end)

    OriginalNewIndex = hookfunction(mt.__newindex, function(self, key, value)
        if ST.SpoofActive and typeof(self) == "Instance" and self:IsA("Humanoid") and key == "WalkSpeed" then
            local char = self.Parent
            if char and Players:GetPlayerFromCharacter(char) == LP then
                ST.RealSpeed = value
                return OriginalNewIndex(self, key, ST.SpeedPool[ST.CurrentIndex] or 16)
            end
        end
        return OriginalNewIndex(self, key, value)
    end)

    setreadonly(mt, true)
    _G.ExtOriginalIndex = OriginalIndex
    _G.ExtOriginalNewIndex = OriginalNewIndex
end
