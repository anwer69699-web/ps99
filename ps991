-- ===== REMOTE UTILITIES =====
local CachedRemote = nil
local RemoteSearched = false

local function resolveRemote(path)
    if not path or path == "" then return nil end
    local ok, result = pcall(function()
        local obj = game
        local cleaned = path:gsub("^game%.", "")
        for seg in cleaned:gmatch("[^%.]+") do
            if obj then
                if typeof(obj) == "Instance" then
                    obj = obj:FindFirstChild(seg)
                else
                    obj = obj[seg]
                end
            else
                return nil
            end
        end
        return obj
    end)
    if ok and result and typeof(result) == "Instance" then return result end
    return nil
end

local function FindAnyRemote()
    if CachedRemote then
        if CachedRemote.Parent then return CachedRemote end
        CachedRemote = nil
        RemoteSearched = false
    end
    for _, path in ipairs(REMOTE_PATHS) do
        local remote = resolveRemote(path)
        if remote then
            CachedRemote = remote
            RemoteSearched = true
            return remote
        end
    end
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        for _, child in ipairs(RS:GetDescendants()) do
            if child:IsA("RemoteEvent") or child:IsA("UnreliableRemoteEvent") or child:IsA("RemoteFunction") then
                CachedRemote = child
                RemoteSearched = true
                return
            end
        end
    end)
    RemoteSearched = true
    return CachedRemote
end

-- ===== LAGGER SYSTEM =====
-- ===== OPTIMIZED: Same payload, same power, ZERO client waste =====
-- Build ONCE, reuse FOREVER. Same table reference sent every tick.
-- Lua tables are references - all 295K entries point to SAME nested object.
-- GC never runs because nothing new is allocated in the loop.
-- Removed InvokeServer (sync freeze) → FireServer only (async).
-- Cached remote → no search per frame.
-- KBPS limit set ONCE at start, not every frame.
-- Payload freed on stop → memory reclaimed instantly.
local ReusablePayload = nil
local PayloadBuildKey = nil  -- tracks config used to build current payload
local CachedLagRemote = nil
local PayloadRebuildTimer = nil

local function BuildPayloadOnce(tc, bs)
    -- Check if we already have a payload for these exact params
    local key = tostring(tc) .. "_" .. tostring(bs)
    if ReusablePayload and PayloadBuildKey == key then
        return ReusablePayload
    end
    -- Build new payload only when config actually changes
    ReusablePayload = nil
    PayloadBuildKey = key
    -- KEY TRICK: all table.insert(m, n) insert REFERENCES to the SAME table n.
    -- Lua doesn't copy - it stores a pointer. So 295K entries = ~130KB of pointers,
    -- not 295K separate table objects.
    -- The chain: m[1]=n, m[2]=n, m[3]=n... all point to ONE nested structure.
    -- Serialization cost is O(n) pointers, but client alloc cost is O(1).
    local m = {}
    local n = {}
    local z = n
    for i = 1, tc do
        local ins = {}
        table.insert(z, ins)
        z = ins
    end
    local mi = math.floor(bs / (tc + 2))
    for i = 1, mi do
        table.insert(m, n)  -- reference, NOT copy
        if i % 8000 == 0 then task.wait() end
    end
    ReusablePayload = m
    return m
end

-- Debounced rebuild: waits 0.3s after last call before actually rebuilding
-- Prevents lag spikes when slider is dragged rapidly (was rebuilding every pixel)
local function RebuildPayload()
    if PayloadRebuildTimer then
        task.cancel(PayloadRebuildTimer)
        PayloadRebuildTimer = nil
    end
    PayloadRebuildTimer = task.delay(0.3, function()
        ReusablePayload = nil
        PayloadBuildKey = nil
        CachedLagRemote = nil
        if LAG_ST.LaggerOn then
            BuildPayloadOnce(LAG_CONFIG.tables, LAG_CONFIG.batchSize)
        end
    end)
end

-- Pre-build payload once, reuse it FOREVER (ZERO allocation in lag loop)
function PrebuildPayloads()
    BuildPayloadOnce(LAG_CONFIG.tables, LAG_CONFIG.batchSize)
end

-- Store references to kill EVERYTHING on stop
local activeInvokeThreads = {}
local invokeCooldown = false

local function startLagger()
    if LAG_ST.LaggerThread then return end
    -- Pre-build payload (built once, reused as reference)
    PrebuildPayloads()
    -- Set bandwidth limit ONCE at start (persists until changed, no need per-frame)
    pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge) end)
    -- Cache remote reference ONCE at start (avoids FindAnyRemote search every frame)
    CachedLagRemote = FindAnyRemote()
    -- Reset invoke tracking
    activeInvokeThreads = {}
    invokeCooldown = false
    local function startLaggerLoop()
        while LAG_ST.LaggerOn and _G.ExtRunning and CoreActive do
            -- Refresh cached remote only if it got destroyed/removed
            if not CachedLagRemote or not CachedLagRemote.Parent then
                CachedLagRemote = FindAnyRemote()
            end
            if CachedLagRemote and ReusablePayload then
                if CachedLagRemote:IsA("RemoteEvent") or CachedLagRemote:IsA("UnreliableRemoteEvent") then
                    -- FireServer = async, sends and forgets, zero wait, zero freeze
                    pcall(function() CachedLagRemote:FireServer(ReusablePayload) end)
                elseif CachedLagRemote:IsA("RemoteFunction") then
                    -- Spawn in separate thread so main loop never freezes.
                    -- Cooldown: don't spawn new thread if previous InvokeServer
                    -- hasn't returned yet - prevents thread pileup.
                    if not invokeCooldown then
                        invokeCooldown = true
                        local thread = coroutine.create(function()
                            pcall(function() CachedLagRemote:InvokeServer(ReusablePayload) end)
                            invokeCooldown = false
                            -- Auto-remove from tracking list when done
                            for i = #activeInvokeThreads, 1, -1 do
                                if activeInvokeThreads[i] == thread then
                                    table.remove(activeInvokeThreads, i)
                                end
                            end
                        end)
                        table.insert(activeInvokeThreads, thread)
                        coroutine.resume(thread)
                    end
                end
            end
            -- Direct task.wait - main thread never blocked
            task.wait(math.max(LAG_CONFIG.loopWait, 0.05))
        end
    end
    LAG_ST.LaggerOn = true
    LAG_ST.LaggerThread = coroutine.create(startLaggerLoop)
    coroutine.resume(LAG_ST.LaggerThread)
    _G.ExtLagThread = LAG_ST.LaggerThread
end

local function stopLagger()
    LAG_ST.LaggerOn = false
    -- STEP 1: Kill ALL InvokeServer threads waiting for server response
    -- These are holding pending requests that will keep sending data
    for _, t in ipairs(activeInvokeThreads) do
        pcall(function() coroutine.close(t) end)
    end
    activeInvokeThreads = {}
    invokeCooldown = false
    -- STEP 2: Close main lagger loop
    if LAG_ST.LaggerThread then
        pcall(function() coroutine.close(LAG_ST.LaggerThread) end)
        LAG_ST.LaggerThread = nil
        _G.ExtLagThread = nil
    end
    -- STEP 3: Destroy payload immediately - Lua GC drops the 295K pointer table
    -- Even if Roblox's network layer cached serialized bytes, they reference
    -- freed Lua tables = server may fail to deserialize = messages dropped silently
    ReusablePayload = nil
    PayloadBuildKey = nil
    -- STEP 4: Invalidate cached remote so no code can accidentally send more
    CachedLagRemote = nil
    if PayloadRebuildTimer then
        task.cancel(PayloadRebuildTimer)
        PayloadRebuildTimer = nil
    end
    -- STEP 5: NETWORK FLUSH - kill ALL queued messages in outgoing buffer
    -- Roblox buffers outgoing remote calls in its network layer.
    -- Even after we stop sending, queued messages still transmit to the server.
    -- Fix: set KBPS to 0 = hard blocks ALL outgoing network traffic.
    -- The network layer drops/abandons the queued lagger payloads because
    -- they can't fit through a 0-byte pipe. Normal game traffic (movement,
    -- inputs) uses the internal replication channel which is NOT affected
    -- by SetOutgoingKBPSLimit (it only throttles remote events).
    pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(0) end)
    task.wait(0.2)
    -- After the queue is dead, restore normal bandwidth
    pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(10000) end)
end

-- ===== CLIENT ANTI-LAG =====
local ClientAntiLagConnections = {}

local function StartClientAntiLag()
    if not ST.ClientAntiLagOn then return end
    for _, c in ipairs(ClientAntiLagConnections) do
        pcall(function() c:Disconnect() end)
    end
    ClientAntiLagConnections = {}

    local function hookR(r)
        if not r or not r.Parent then return end
        pcall(function()
            if r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") then
                table.insert(ClientAntiLagConnections, r.OnClientEvent:Connect(function() return end))
            end
        end)
    end
    for _, path in ipairs(REMOTE_PATHS) do
        local r = resolveRemote(path)
        if r then hookR(r) end
    end

    pcall(function()
        table.insert(ClientAntiLagConnections, game:GetService("ReplicatedStorage").DescendantAdded:Connect(function(d)
            if d:IsA("RemoteEvent") or d:IsA("UnreliableRemoteEvent") then
                task.wait(0.5)
                hookR(d)
            end
        end))
    end)

    task.spawn(function()
        while _G.ExtRunning and CoreActive and ST.ClientAntiLagOn do
            pcall(function()
                for _, ch in ipairs(CoreGui:GetChildren()) do
                    if ch.Name:find("BlockList") or ch.Name:find("PlayerBlock") then
                        local extAuth = ch:GetAttribute("ExtAuth")
                        if extAuth == nil then
                            pcall(function() ch:Destroy() end)
                        end
                    end
                end
                local pg = LP:FindFirstChildOfClass("PlayerGui")
                if pg then
                    for _, ch in ipairs(pg:GetChildren()) do
                        if ch.Name:find("BlockList") or ch.Name:find("PlayerBlock") then
                            pcall(function() ch:Destroy() end)
                        end
                    end
                end
            end)
            task.wait(2)
        end
    end)
end
StartClientAntiLag()

