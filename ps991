-- ===== FIND NEAREST PLAYER =====
local function FindNearest()
    local h = gH()
    if not h then return nil end
    local n, md = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local o = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if o and hum and hum.Health > 0 then
                local validPos, isSpoofed = ValidateTargetPosition(p, p.Character)
                if validPos and not isSpoofed then
                    local d = (h.Position - validPos).Magnitude
                    if d < md then
                        md = d
                        n = p
                    end
                elseif validPos and isSpoofed then
                    local d = (h.Position - validPos).Magnitude + 10
                    if d < md then
                        md = d
                        n = p
                    end
                end
            end
        end
    end
    return n
end

