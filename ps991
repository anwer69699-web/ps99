-- ===== LOCK SYSTEM =====
local Y_OFFSET = 3 -- المسافة اللي بيكون فيها أسفل الهدف إذا كان مرتفع

local function sP()
    ST.LKA = false
    ST.LockOn = false
    ST.LockTarget = nil
    ST.LastTargetPos = nil
    ST.LastTargetTime = 0
    ST.PredictedVel = Vector3.zero
    ST.LockBrokenBySpoof = false
    local h = gH()
    if h then
        pcall(function()
            h.Velocity = Vector3.new(0, h.Velocity.Y, 0)
            local a = h:FindFirstChild("LockAngVel")
            if a then a:Destroy() end
            local t = h:FindFirstChild("LockBodyAtt")
            if t then t:Destroy() end
        end)
    end
end

local function ProcessLockFrame(dt)
    local h = gH()
    if not h or not h.Parent then
        ST.LKA = false
        ST.LockOn = false
        return
    end

    local t = FindNearest()
    if t and t.Character then
        local e = t.Character:FindFirstChild("HumanoidRootPart")
        local hum = t.Character:FindFirstChildOfClass("Humanoid")
        if e and hum and hum.Health > 0 then
            local validPos, isSpoofed, spoofType = ValidateTargetPosition(t, t.Character)

            if not validPos then
                ST.LockBrokenBySpoof = true
                if not ST.SpoofAlertShown then
                    Notify("EXTERNAL HUB", L("target_ghosted") .. ": " .. (spoofType or "UNKNOWN"), 2, C.YEL)
                    ST.SpoofAlertShown = true
                    task.delay(3, function() ST.SpoofAlertShown = false end)
                end
                local altTarget = FindNearest()
                if altTarget and altTarget ~= t then
                    t = altTarget
                    e = t.Character and t.Character:FindFirstChild("HumanoidRootPart")
                    if not e then return end
                    validPos = e.Position
                    isSpoofed = false
                else
                    h.Velocity = Vector3.new(0, h.Velocity.Y, 0)
                    pcall(function()
                        local a = h:FindFirstChild("LockAngVel")
                        if a then a.AngularVelocity = Vector3.new(0, 0, 0) end
                    end)
                    return
                end
            end

            -- نظام التحت: تحديد نقطة التتبع المنخفضة
            local targetPos = validPos
            if validPos.Y > h.Position.Y then
                targetPos = Vector3.new(validPos.X, validPos.Y - Y_OFFSET, validPos.Z)
            end

            local now = tick()
            if ST.LockTarget ~= t then
                ST.LockTarget = t
                ST.LastTargetPos = validPos
                ST.LastTargetTime = now
                ST.PredictedVel = Vector3.zero
                ResetTargetTracking(t)
            else
                local timeDiff = now - ST.LastTargetTime
                if timeDiff > 0.01 then
                    local newVel = (validPos - ST.LastTargetPos) / timeDiff
                    local velDiff = (newVel - ST.PredictedVel).Magnitude
                    if velDiff < ANTI_EXPLOIT.VELOCITY_OUTLIER_THRESHOLD then
                        ST.PredictedVel = ST.PredictedVel * 0.6 + newVel * 0.4
                    else
                        ST.PredictedVel = ST.PredictedVel * 0.85 + newVel * 0.15
                    end
                    ST.LastTargetPos = validPos
                    ST.LastTargetTime = now
                end
            end

            local lS = gNS()
            pcall(function()
                local lhm = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if lhm then lhm.WalkSpeed = lS end
            end)

            local LOCK_INTERCEPT_DIST = 18
            local fullVel = ST.PredictedVel
            local horizVel = Vector3.new(fullVel.X, 0, fullVel.Z)
            local horizSpeed = horizVel.Magnitude
            local horizDir = horizSpeed > 1 and horizVel.Unit or Vector3.zero

            local interceptPos = validPos + horizDir * LOCK_INTERCEPT_DIST
            local yVel = fullVel.Y
            if math.abs(yVel) > 1 then
                interceptPos = Vector3.new(interceptPos.X, validPos.Y + yVel * 0.15, interceptPos.Z)
            end

            -- نظام التحت: تطبيق النزول على نقطة الاعتراض (Intercept)
            if validPos.Y > h.Position.Y then
                interceptPos = Vector3.new(interceptPos.X, interceptPos.Y - Y_OFFSET, interceptPos.Z)
            end

            local distToIntercept = (interceptPos - h.Position).Magnitude
            if distToIntercept > ANTI_EXPLOIT.MAX_TELEPORT_DIST then
                local dir = (interceptPos - h.Position).Unit
                interceptPos = h.Position + dir * ANTI_EXPLOIT.MAX_TELEPORT_DIST
            end

            local moveTarget
            local distToTarget = (targetPos - h.Position).Magnitude

            if horizSpeed > 1 and distToIntercept > 3 then
                moveTarget = interceptPos
            else
                moveTarget = targetPos
            end

            local distToMoveTarget = (moveTarget - h.Position).Magnitude
            if distToMoveTarget > ANTI_EXPLOIT.MAX_TELEPORT_DIST then
                local dir = (moveTarget - h.Position).Unit
                moveTarget = h.Position + dir * ANTI_EXPLOIT_MAX_TELEPORT_DIST -- خطأ مقصود للمقارنة
            end

            local toTarget = moveTarget - h.Position
            local hV = Vector3.new(0, 0, 0)
            if toTarget.Magnitude > 0.5 then
                hV = toTarget.Unit * lS
            end

            h.Velocity = hV

            pcall(function()
                local a = h:FindFirstChild("LockAngVel")
                if a then
                    -- نظام التحت: التوجيه يروح للنقطة المنخفضة (targetPos) بدل الأصلية
                    local dCF = CFrame.lookAt(h.Position, targetPos)
                    local rCF = h.CFrame:ToObjectSpace(dCF)
                    local ax, an = rCF:ToAxisAngle()
                    if an > 0.01 then
                        a.AngularVelocity = h.CFrame:VectorToWorldSpace(ax) * (an * 45)
                    else
                        a.AngularVelocity = Vector3.new(0, 0, 0)
                    end
                end
            end)

            ST.lockCD = ST.lockCD - dt
            if ST.lockCD <= 0 then
                local tl = FindBat()
                if tl then
                    pcall(function() tl:Activate() end)
                end
                ST.lockCD = 0.08
            end
        else
            h.Velocity = Vector3.new(0, h.Velocity.Y, 0)
            pcall(function()
                local a = h:FindFirstChild("LockAngVel")
                if a then a.AngularVelocity = Vector3.new(0, 0, 0) end
            end)
        end
    else
        h.Velocity = Vector3.new(0, h.Velocity.Y, 0)
        pcall(function()
            local a = h:FindFirstChild("LockAngVel")
            if a then a.AngularVelocity = Vector3.new(0, 0, 0) end
        end)
    end
end

