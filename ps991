-- ===== AUTO MOVE SYSTEM =====
local AutoMoveThread = nil

local function StopAutoMove()
    if AutoMoveThread then
        pcall(function() coroutine.close(AutoMoveThread) end)
        AutoMoveThread = nil
    end
    ST.AutoLeftOn = false
    ST.AutoRightOn = false
    ST.AutoMoveStuckTimer = 0
    ST.AutoMoveLastPos = Vector3.zero
    local h = gH()
    if h then
        pcall(function() h.Velocity = Vector3.new(0, h.Velocity.Y, 0) end)
    end
    if SyncToggles then SyncToggles() end
end

local function StartAutoMove(mode)
    StopAutoMove()
    local coords = mode == "AUTO_LEFT" and AUTO_LEFT_COORDS or AUTO_RIGHT_COORDS
    if mode == "AUTO_LEFT" then
        ST.AutoLeftOn = true
    else
        ST.AutoRightOn = true
    end
    if SyncToggles then SyncToggles() end

    AutoMoveThread = coroutine.create(function()
        local pointIdx = 1
        local lastPointIdx = #coords
        ST.AutoMoveStuckTimer = 0
        ST.AutoMoveLastPos = Vector3.zero

        while _G.ExtRunning and CoreActive and (ST.AutoLeftOn or ST.AutoRightOn) do
            local h = gH()
            if not h or not h.Parent then
                task.wait(0.01)
                continue
            end

            if pointIdx > lastPointIdx then
                h.Velocity = Vector3.new(0, h.Velocity.Y, 0)
                StopAutoMove()
                return
            end

            local targetCoord = coords[pointIdx]
            local tx, ty, tz = GetCoord(targetCoord)
            local targetPos = Vector3.new(tx, ty, tz)
            local toTarget = targetPos - h.Position

            if ST.AutoMoveLastPos then
                local moved = (h.Position - ST.AutoMoveLastPos).Magnitude
                if moved < ANTI_EXPLOIT.STUCK_DIST_THRESHOLD then
                    ST.AutoMoveStuckTimer = ST.AutoMoveStuckTimer + 0.01
                    if ST.AutoMoveStuckTimer > ANTI_EXPLOIT.STUCK_TIMEOUT then
                        local hm = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                        if hm then
                            pcall(function() hm:ChangeState(Enum.HumanoidStateType.Jumping) end)
                        end
                        ST.AutoMoveStuckTimer = 0
                    end
                else
                    ST.AutoMoveStuckTimer = 0
                end
            end
            ST.AutoMoveLastPos = h.Position

            local pathDeviation = math.abs(h.Position.X - tx) + math.abs(h.Position.Z - tz)
            if pathDeviation > ANTI_EXPLOIT.PATH_DEVIATION_MAX then
                local correctionDir = (targetPos - h.Position).Unit
                local correctionSpeed = (pointIdx >= 3) and gSS() or gNS()
                h.Velocity = Vector3.new(
                    correctionDir.X * correctionSpeed,
                    h.Velocity.Y,
                    correctionDir.Z * correctionSpeed
                )
                task.wait(0.01)
                continue
            end

            local xzDist = Vector3.new(toTarget.X, 0, toTarget.Z).Magnitude
            local yDist = math.abs(toTarget.Y)

            if xzDist < AUTO_MOVE_XZ_TOLERANCE and yDist < AUTO_MOVE_Y_TOLERANCE then
                if pointIdx >= lastPointIdx then
                    h.Velocity = Vector3.new(0, h.Velocity.Y, 0)
                    StopAutoMove()
                    return
                else
                    local nextIdx = pointIdx + 1
                    if nextIdx <= lastPointIdx then
                        local nextCoord = coords[nextIdx]
                        local nx, ny, nz = GetCoord(nextCoord)
                        local nextPos = Vector3.new(nx, ny, nz)
                        local toNext = nextPos - h.Position
                        if toNext.Magnitude > 0.1 then
                            local nextDir = toNext.Unit
                            local spd = (nextIdx >= 3) and gSS() or gNS()
                            h.Velocity = Vector3.new(
                                nextDir.X * spd,
                                h.Velocity.Y,
                                nextDir.Z * spd
                            )
                        end
                    end
                    pointIdx = pointIdx + 1
                end
            else
                local spd = (pointIdx >= 3) and gSS() or gNS()
                local moveDir = Vector3.new(toTarget.X, 0, toTarget.Z).Unit
                h.Velocity = Vector3.new(
                    moveDir.X * spd,
                    h.Velocity.Y,
                    moveDir.Z * spd
                )
            end

            task.wait(0.01)
        end
    end)
    coroutine.resume(AutoMoveThread)
end

