-- ===== GUI PROTECTION =====
local function ProtectGui(g)
    if not g then return end
    local n = g.Name
    g.Changed:Connect(function(p)
        if p == "Parent" and not g.Parent then
            pcall(function() g.Parent = CoreGui end)
        end
        if p == "Name" and g.Name ~= n then
            pcall(function() g.Name = n end)
        end
    end)
end
