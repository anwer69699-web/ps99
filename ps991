    -- Slider interaction - LockPower changes LAG_CONFIG in real-time
    -- Display shows current values: Tables, LoopWait, BatchSize
    local sliding = false
    local function updateSlider(input)
        local pos = input.Position.X
        local bgAbs = sliderBg.AbsolutePosition.X
        local bgSize = sliderBg.AbsoluteSize.X
        local relativeX = math.clamp((pos - bgAbs) / bgSize, 0, 1)
        local power = math.floor(relativeX * 100)
        if power < 1 then power = 1 end
        ST.LockPower = power

        -- Calculate new values based on power
        local powerFactor = power / 100
        local newTables = math.floor(60 + (60 * powerFactor))
        local newWait = math.round((1.0 - (0.7 * powerFactor)) * 100) / 100
        local newBatch = math.floor(100000 + (200000 * powerFactor))

        -- Apply to LAG_CONFIG
        LAG_CONFIG.tables = newTables
        LAG_CONFIG.loopWait = newWait
        LAG_CONFIG.batchSize = newBatch

        -- Debounced payload rebuild (waits 0.3s after last slider move)
        -- Before: rebuilt on EVERY pixel drag = massive lag spike
        -- After: builds once after slider stops moving = zero lag
        RebuildPayload()

        -- Update display with current values
        powerLabel.Text = "LOCK POWER: " .. power .. "% | T:" .. newTables .. " W:" .. newWait .. "s B:" .. newBatch
        sliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
        sliderKnob.Position = UDim2.new(relativeX, -8 * SC, 0.5, -8 * SC)
    end

