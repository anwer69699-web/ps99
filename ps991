local function ResetTargetTracking(player)
    if not player then return end
    ST.TargetPosHistory[player] = nil
    ST.TargetVelHistory[player] = nil
    ST.TargetConsistentFrames[player] = nil
    ST.TargetGhostTimers[player] = nil
    ST.TargetLastValidPos[player] = nil
    ST.TargetSpoofCount[player] = nil
end

local function CheckGhostChar(player, char)
    if not ANTI_EXPLOIT.ANTI_INVISIBLE_CHECK then return false end
    local allInv = true
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Transparency < 0.9 then
            allInv = false
            break
        end
    end
    if allInv then
        ST.TargetGhostTimers[player] = (ST.TargetGhostTimers[player] or 0) + 0.01
        if ST.TargetGhostTimers[player] > ANTI_EXPLOIT.GHOST_CHAR_TIMEOUT then
            return true
        end
    else
        ST.TargetGhostTimers[player] = 0
    end
    return false
end

local function CheckTeleportAndSpeed(player, curPos, curVel, hist)
    if #hist < 2 then return false, nil end
    local prev = hist[#hist - 1]
    local td = tick() - prev.time
    if td <= 0.001 then return false, nil end
    local dist = (curPos - prev.pos).Magnitude
    if dist > ANTI_EXPLOIT.MAX_TELEPORT_DIST and td < 0.5 then
        ST.TargetSpoofCount[player] = (ST.TargetSpoofCount[player] or 0) + 1
        return true, "TELEPORT_SPOOF"
    end
    if ANTI_EXPLOIT.ANTI_VELOCITY_SPOOF then
        if Vector3.new(curVel.X, 0, curVel.Z).Magnitude > ANTI_EXPLOIT.VELOCITY_OUTLIER_THRESHOLD then
            ST.TargetSpoofCount[player] = (ST.TargetSpoofCount[player] or 0) + 1
            return true, "VELOCITY_SPOOF"
        end
    end
    return false, nil
end

local function CheckPositionJitter(player, hist)
    if #hist < 5 then return false, nil end
    local rp = {}
    for i = #hist - 4, #hist do table.insert(rp, hist[i].pos) end
    local jc = 0
    for i = 3, #rp do
        local d1 = (rp[i] - rp[i-1]).Magnitude
        local d2 = (rp[i-1] - rp[i-2]).Magnitude
        if d1 > ANTI_EXPLOIT.DESYNC_THRESHOLD and d2 > ANTI_EXPLOIT.DESYNC_THRESHOLD then
            if (rp[i] - rp[i-1]):Dot(rp[i-1] - rp[i-2]) < -0.5 * d1 * d2 then
                jc = jc + 1
            end
        end
    end
    if jc >= 2 then
        ST.TargetSpoofCount[player] = (ST.TargetSpoofCount[player] or 0) + 1
        return true, "POSITION_JITTER"
    end
    return false, nil
end

local function CheckAngleSpoof(player, hist)
    if not ANTI_EXPLOIT.ANTI_ANGLE_SPOOF or #hist < 3 then return false, nil end
    local angles = {}
    for i = #hist - 2, #hist do
        local hv = Vector3.new(hist[i].vel.X, 0, hist[i].vel.Z)
        if hv.Magnitude > 1 then table.insert(angles, math.atan2(hv.X, hv.Z)) end
    end
    if #angles >= 2 then
        for i = 2, #angles do
            local ad = math.abs(angles[i] - angles[i-1])
            if ad > math.pi then ad = 2 * math.pi - ad end
            if ad > ANTI_EXPLOIT.ANGLE_CHANGE_LIMIT * 0.015 then
                ST.TargetSpoofCount[player] = (ST.TargetSpoofCount[player] or 0) + 1
                return true, "ANGLE_SPOOF"
            end
        end
    end
    return false, nil
end

local function CheckHitboxSpoof(player, char)
    if not ANTI_EXPLOIT.ANTI_NETWORK_OWNERSHIP then return false, nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, nil end
    local off = hrp.CFrame:PointToObjectSpace(hrp.Position)
    if off.Magnitude > ANTI_EXPLOIT.HITBOX_SPOOF_DIST then
        ST.TargetSpoofCount[player] = (ST.TargetSpoofCount[player] or 0) + 1
        return true, "HITBOX_SPOOF"
    end
    return false, nil
end

local function CheckFakeRagdoll(player, char, curVel)
    if not ANTI_EXPLOIT.ANTI_FAKE_RAGDOLL then return false, nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false, nil end
    local st = hum:GetState()
    if st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Physics then
        if Vector3.new(curVel.X, 0, curVel.Z).Magnitude > 30 then
            ST.TargetSpoofCount[player] = (ST.TargetSpoofCount[player] or 0) + 1
            return true, "FAKE_RAGDOLL"
        end
    end
    return false, nil
end

local function CheckPositionReset(player, hist)
    if not ANTI_EXPLOIT.ANTI_POSITION_RESET or #hist < 4 then return false, nil end
    local cur = hist[#hist].pos
    for i = 1, #hist - 3 do
        if (cur - hist[i].pos).Magnitude < 1 and i < #hist - 2 then
            local mmd = 0
            for j = i + 1, #hist - 1 do
                local d = (hist[j].pos - cur).Magnitude
                if d > mmd then mmd = d end
            end
            if mmd > ANTI_EXPLOIT.DESYNC_THRESHOLD then
                ST.TargetSpoofCount[player] = (ST.TargetSpoofCount[player] or 0) + 1
                return true, "POSITION_RESET"
            end
        end
    end
    return false, nil
end

local function ValidateTargetPosition(player, char)
    if not player or not char then return nil, true, "NO_CHAR" end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return nil, true, "NO_HRP" end

    local currentPos = hrp.Position
    local currentVel = hrp.AssemblyLinearVelocity

    if CheckGhostChar(player, char) then return nil, true, "GHOST_CHAR" end
    if hum.Health <= ANTI_EXPLOIT.MIN_VALID_HEALTH then return nil, true, "DEAD" end

    if not ST.TargetPosHistory[player] then ST.TargetPosHistory[player] = {} end
    local history = ST.TargetPosHistory[player]
    table.insert(history, { pos = currentPos, time = tick(), vel = currentVel })
    if #history > ANTI_EXPLOIT.POS_HISTORY_SIZE then table.remove(history, 1) end

    local isSpoofed, spoofType = false, nil
    local s, t

    s, t = CheckTeleportAndSpeed(player, currentPos, currentVel, history)
    if s then isSpoofed, spoofType = true, t end

    if not isSpoofed then
        s, t = CheckPositionJitter(player, history)
        if s then isSpoofed, spoofType = true, t end
    end

    if not isSpoofed then
        s, t = CheckAngleSpoof(player, history)
        if s then isSpoofed, spoofType = true, t end
    end

    if not isSpoofed then
        s, t = CheckHitboxSpoof(player, char)
        if s then isSpoofed, spoofType = true, t end
    end

    if not isSpoofed then
        s, t = CheckFakeRagdoll(player, char, currentVel)
        if s then isSpoofed, spoofType = true, t end
    end

    if not isSpoofed then
        s, t = CheckPositionReset(player, history)
        if s then isSpoofed, spoofType = true, t end
    end

    if isSpoofed then
        local spoofCount = ST.TargetSpoofCount[player] or 0
        if spoofCount > 5 then
            if ST.TargetLastValidPos[player] then
                return ST.TargetLastValidPos[player], true, spoofType
            end
            return nil, true, spoofType
        end
        if ST.TargetLastValidPos[player] then
            return ST.TargetLastValidPos[player]:Lerp(currentPos, 1 - ANTI_EXPLOIT.POSITION_SMOOTH_FACTOR), true, spoofType
        end
        return currentPos, true, spoofType
    end

    ST.TargetConsistentFrames[player] = (ST.TargetConsistentFrames[player] or 0) + 1
    ST.TargetLastValidPos[player] = currentPos
    ST.TargetSpoofCount[player] = math.max(0, (ST.TargetSpoofCount[player] or 0) - 1)
    return currentPos, false, nil
end

local function SmartPredictPosition(player, char, dt)
    if not player or not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local validPos, isSpoofed, spoofType = ValidateTargetPosition(player, char)
    if not validPos then return nil end
    local predictFactor = isSpoofed and 0.2 or 0.6
    local history = ST.TargetPosHistory[player]
    if not history or #history < 3 then
        return validPos
    end
    local recentCount = math.min(#history, 5)
    local avgVel = Vector3.zero
    for i = #history - recentCount + 2, #history do
        local timeDiff = history[i].time - history[i - 1].time
        if timeDiff > 0.001 then
            local vel = (history[i].pos - history[i - 1].pos) / timeDiff
            avgVel = avgVel + vel
        end
    end
    avgVel = avgVel / (recentCount - 1)
    local horizVel = Vector3.new(avgVel.X, 0, avgVel.Z)
    if horizVel.Magnitude > ANTI_EXPLOIT.MAX_SPEED_DIFF then
        horizVel = horizVel.Unit * ANTI_EXPLOIT.MAX_SPEED_DIFF
    end
    local latencyComp = math.min(ANTI_EXPLOIT.MAX_LATENCY_COMP, 0.15)
    local predictedPos = validPos + horizVel * latencyComp * predictFactor
    if ST.TargetLastValidPos[player] then
        local predictionError = (predictedPos - ST.TargetLastValidPos[player]).Magnitude
        if predictionError > ANTI_EXPLOIT.MAX_PREDICTION_ERROR then
            predictedPos = ST.TargetLastValidPos[player]:Lerp(predictedPos, ANTI_EXPLOIT.MAX_PREDICTION_ERROR / predictionError)
        end
    end
    return predictedPos
end

