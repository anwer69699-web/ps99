--// SETTINGS
local Settings = {
    Tapping = false,
    Teleport = false,
    Key1 = false,
    KeyR2 = false,
    ClickPoint = false,
    ClickPos = nil,
    AutoJump = false,
    Range = 250
}

--// ANTI AFK
Player.Idled:Connect(function()
    VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(1)
    VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

--// FORCE TAP
local LastHit = 0
local function ForceTap(target)
    if not target then return end
    if tick() - LastHit < 0.15 then return end
    LastHit = tick()

    if damageRemote then
        damageRemote:FireServer(target.Name)
    end

    if tapper then
        if tapper:IsA("RemoteFunction") then
            tapper:InvokeServer(true)
        else
            tapper:FireServer(true)
        end
    end
end

--// TARGET
local function GetClosest()
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local root = char.HumanoidRootPart
    local best, dist = nil, Settings.Range

    local folder = WS:FindFirstChild("__THINGS")
    folder = folder and folder:FindFirstChild("Breakables")
    if not folder then return end

    for _, v in ipairs(folder:GetChildren()) do
        local p = v:FindFirstChild("Main") or v:FindFirstChildWhichIsA("BasePart", true)
        if p then
            local d = (root.Position - p.Position).Magnitude
            if d < dist then
                dist = d
                best = v
            end
        end
    end

    return best
end

--// CLICK SYSTEM
local function CaptureMousePosition()
    print("حدد موقع خلال 3 ثواني...")
    for i = 3,1,-1 do
        print(i)
        task.wait(1)
    end

    Settings.ClickPos = UIS:GetMouseLocation()
    print("تم حفظ الموقع")
end

local function ClickSavedPosition()
    if not Settings.ClickPos then return end

    local x = Settings.ClickPos.X
    local y = Settings.ClickPos.Y

    VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.05)
    VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

--// KEY PRESS
local function PressKey(key)
    VIM:SendKeyEvent(true, key, false, game)
    task.wait(0.05)
    VIM:SendKeyEvent(false, key, false, game)
end

--// AUTO JUMP
task.spawn(function()
    while true do
        task.wait(5)
        if Settings.AutoJump then
            local char = Player.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end)

--// MAIN LOOP
task.spawn(function()
    while true do
        task.wait(Settings.Tapping and 0.08 or 0.25)

        if Settings.Tapping then
            local target = GetClosest()
            if target then
                ForceTap(target)

                if Settings.Teleport then
                    local part = target:FindFirstChild("Main") or target:FindFirstChildWhichIsA("BasePart", true)
                    if part and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
                        Player.Character.HumanoidRootPart.CFrame = part.CFrame * CFrame.new(0, 5, 0)
                    end
                end
            end
        end
    end
end)

--// KEY LOOPS
task.spawn(function()
    while true do
        task.wait(5)
        if Settings.Key1 then
            PressKey(Enum.KeyCode.One)
            if Settings.ClickPoint then
                task.wait(0.2)
                ClickSavedPosition()
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(5)
        if Settings.KeyR2 then
            PressKey(Enum.KeyCode.R)
            task.wait(0.1)
            PressKey(Enum.KeyCode.Two)

            if Settings.ClickPoint then
                task.wait(0.2)
                ClickSavedPosition()
            end
        end
    end
end)

